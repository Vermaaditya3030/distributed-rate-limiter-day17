FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY rate-limit-service/pom.xml rate-limit-service/pom.xml
COPY rate-limit-service/src rate-limit-service/src
RUN mvn -pl rate-limit-service -am package -DskipTests
FROM eclipse-temurin:17-jre
COPY --from=build /app/rate-limit-service/target/rate-limit-service-1.0.0.jar app.jar
ENTRYPOINT ["java","-jar","/app.jar"]
